{
  "author": "Jason Williscroft",
  "bugs": {
    "url": "https://github.com/karmaniverous/fooboard/issues"
  },
  "dependencies": {
    "@aws-sdk/client-amplify": "^3.1152.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "clsx": "^2.1.1",
    "json-p3": "^3.0.1",
    "lucide-react": "^1.59.0",
    "radash": "^12.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "description": "fooboard: a free, open-source, client-only browser app showing the deployment state of every repo x stage at a glance, fed directly from GitHub Actions runs and Amplify jobs.",
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.38.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "git-cliff": "^2.14.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "knip": "^6.41.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "release-it": "^21.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  },
  "homepage": "https://fooboard.dev",
  "keywords": [
    "amplify",
    "deployment",
    "dashboard",
    "github-actions",
    "status-board"
  ],
  "license": "BSD-3-Clause",
  "name": "fooboard",
  "private": true,
  "release-it": {
    "git": {
      "changelog": "npx git-cliff --unreleased --strip header",
      "commitMessage": "chore: release v${version}",
      "requireBranch": "main"
    },
    "github": {
      "release": true,
      "releaseName": "fooboard@${version}",
      "releaseNotes": "npx git-cliff --tag ${version} --unreleased --strip header"
    },
    "hooks": {
      "after:init": [
        "npm run lint",
        "npm run typecheck",
        "npm run test",
        "npm run knip",
        "npm run build"
      ],
      "after:release": [
        "git switch -c release/${version}",
        "git push -u origin release/${version}",
        "git switch ${branchName}"
      ],
      "after:bump": [
        "npx git-cliff --tag ${version} -o CHANGELOG.md",
        "git add CHANGELOG.md"
      ]
    },
    "npm": {
      "publish": false
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karmaniverous/fooboard.git"
  },
  "scripts": {
    "build": "tsc -b --noEmit && vite build",
    "changelog": "git-cliff -o CHANGELOG.md",
    "dev": "vite",
    "knip": "knip",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "preview": "vite preview",
    "release": "dotenvx run -f .env.local -- release-it",
    "release:pre": "dotenvx run -f .env.local -- release-it --no-git.requireBranch --github.prerelease --preRelease",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit"
  },
  "type": "module",
  "version": "0.0.0",
  "overrides": {
    "json-p3": {
      "typescript": "$typescript"
    }
  }
}
