          "rules": {},
          "sourceStageId": "dev",
          "settings": {}
        },
        {
          "id": "stage",
          "name": "Stage",
          "rules": {},
          "sourceStageId": "test",
          "settings": {}
        },
        {
          "id": "prod",
          "name": "Prod",
