            "combine": "and",
            "checks": [
              {
                "path": "$.name",
                "operator": "glob",
                "value": "*deploy*",
                "ignoreCase": true,
                "quantifier": "any",
                "not": false
              }
            ]
          }
        },
        "requestsInFlight": {
          "github": 8,
          "aws": 4
        }
      },
      "stages": [
        {
          "id": "dev",
          "name": "Dev",
          "rules": {},
          "settings": {}
        },
        {
          "id": "test",
