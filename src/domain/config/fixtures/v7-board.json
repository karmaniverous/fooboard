          "record": {
            "combine": "and",
            "checks": [
              {
                "path": "$.name",
                "operator": "glob",
                "value": "Deploy*",
                "ignoreCase": true,
                "quantifier": "any",
                "not": false
              }
            ]
          }
        }
      },
      "settings": {
        "githubToken": "gh-org",
        "awsKey": "aws-dev",
