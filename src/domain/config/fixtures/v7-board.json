{
  "schemaVersion": 5,
  "dashboards": [
    {
      "unmappedDismissals": [],
      "id": "northwind",
      "name": "Northwind deploys",
      "credentials": [
        {
          "id": "gh-org",
          "kind": "github",
          "label": "Northwind org"
        },
        {
          "id": "aws-dev",
          "kind": "aws",
          "label": "Dev account"
        },
        {
          "id": "aws-stage",
          "kind": "aws",
          "label": "Stage account"
        },
        {
          "id": "aws-prod",
          "kind": "aws",
          "label": "Prod account"
        }
